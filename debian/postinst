#!/bin/sh
# Nach der Installation: Dienst fuer den aufrufenden Benutzer einrichten,
# damit die Web-Oberflaeche ohne Handarbeit startet.
set -e

BENUTZER="${SUDO_USER:-}"
if [ -z "$BENUTZER" ] && [ -n "$PKEXEC_UID" ]; then
    BENUTZER=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
fi

if [ -n "$BENUTZER" ] && [ "$BENUTZER" != "root" ]; then
    HEIM=$(getent passwd "$BENUTZER" | cut -d: -f6)
    LAUF=$(loginctl show-user "$BENUTZER" -p RuntimePath --value 2>/dev/null || true)
    if [ -n "$LAUF" ] && [ -S "$LAUF/bus" ]; then
        su - "$BENUTZER" -c "XDG_RUNTIME_DIR=$LAUF systemctl --user daemon-reload" >/dev/null 2>&1 || true
        su - "$BENUTZER" -c "XDG_RUNTIME_DIR=$LAUF systemctl --user enable --now smartys-himalaya-gui-web.service" >/dev/null 2>&1 || true
        echo "Web-Oberflaeche eingerichtet: http://127.0.0.1:8771"
    else
        echo "Hinweis: Dienst konnte nicht automatisch gestartet werden."
        echo "Nach der naechsten Anmeldung ausfuehren:"
        echo "  systemctl --user enable --now smartys-himalaya-gui-web.service"
    fi
fi

echo
echo "Smartys Himalaya GUI ist installiert."
echo "  Fenster-Variante : smartys-himalaya-gui"
echo "  Web-Variante     : http://127.0.0.1:8771"
echo
echo "Voraussetzung: himalaya muss eingerichtet sein (himalaya --version)."
echo "Fehlt es: https://github.com/pimalaya/himalaya"
echo "Konten lassen sich direkt in der Oberflaeche anlegen."

exit 0
